# LOCAL secrets template for Streamlit.
# For local runs: copy this to `.streamlit/secrets.toml` and add your key
#   (or just keep using the project `.env` — either works locally).
# For Streamlit Community Cloud: DO NOT commit secrets. Instead paste the line
#   below into the app's Settings -> Secrets box in the Streamlit dashboard.

GROQ_API_KEY = "your-groq-api-key-here"
